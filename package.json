{
  "name": "council",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Telegram multi-persona debate system with grounded, cited personas. Runs on free tiers.",
  "scripts": {
    "assets": "node scripts/build-assets.mjs",
    "dev": "npm run assets && wrangler dev",
    "deploy": "npm run assets && wrangler deploy",
    "typecheck:worker": "tsc --noEmit -p tsconfig.json",
    "typecheck:web": "tsc --noEmit -p web/tsconfig.json",
    "typecheck": "npm run typecheck:worker && npm run typecheck:web",
    "selftest": "node scripts/build-assets.mjs && esbuild scripts/selftest.ts --bundle --platform=node --format=cjs --outfile=.test/selftest.cjs --log-level=error && node .test/selftest.cjs",
    "web:dev": "vite --config web/vite.config.ts",
    "web:build": "vite build --config web/vite.config.ts",
    "seed": "node scripts/seed.mjs",
    "set-webhook": "node scripts/set-webhook.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "typescript": "^5.6.2",
    "vite": "^5.4.2",
    "wrangler": "^3.78.0"
  }
}
